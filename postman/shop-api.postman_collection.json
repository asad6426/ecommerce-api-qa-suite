    {
      "name": "API-10 Sold-out product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          }
        ],
        "url": "{{base_url}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"product_id\": 3, \"quantity\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 409', () => pm.response.to.have.status(409));",
              "pm.test('explains the problem', () => pm.expect(pm.response.json().error).to.include('stock'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Setup: login as the second customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"bob\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('bob_token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "API-11 Another customer's order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bob_token}}"
          }
        ],
        "url": "{{base_url}}/api/orders/{{order_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 403', () => pm.response.to.have.status(403));",
              "pm.test('leaks no order data', () => pm.expect(pm.response.json()).to.not.have.property('total'));"
            ]
          }
        }
      ]
    },
